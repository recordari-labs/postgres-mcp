{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "host": {
          "default": "0.0.0.0",
          "type": "string",
          "minLength": 1
        },
        "port": {
          "default": 3000,
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "default": "/mcp",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "pool": {
          "default": {},
          "type": "object",
          "properties": {
            "max": {
              "default": 5,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "connectionTimeoutMs": {
              "default": 5000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "url"
      ]
    },
    "security": {
      "type": "object",
      "properties": {
        "authentication": {
          "type": "object",
          "properties": {
            "type": {
              "default": "bearer",
              "type": "string",
              "const": "bearer"
            },
            "token": {
              "type": "string",
              "minLength": 16
            },
            "resource": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "token"
          ]
        },
        "readonly": {
          "default": true,
          "type": "boolean"
        },
        "access": {
          "default": {},
          "type": "object",
          "properties": {
            "defaultSchema": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "schemas": {
              "default": {},
              "type": "object",
              "properties": {
                "allow": {
                  "default": [
                    "public"
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              }
            },
            "tables": {
              "default": {},
              "type": "object",
              "properties": {
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              }
            }
          }
        },
        "http": {
          "default": {},
          "type": "object",
          "properties": {
            "allowedHosts": {
              "default": [
                "localhost",
                "127.0.0.1",
                "[::1]"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "queries": {
          "default": {},
          "type": "object",
          "properties": {
            "timeoutMs": {
              "default": 10000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxRows": {
              "default": 1000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxConcurrent": {
              "default": 3,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxSqlLength": {
              "default": 10000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "singleStatement": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "introspection": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "expandViews": {
              "default": true,
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "authentication"
      ]
    },
    "logging": {
      "default": {},
      "type": "object",
      "properties": {
        "level": {
          "default": "info",
          "type": "string",
          "enum": [
            "fatal",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ]
        },
        "logQueries": {
          "default": false,
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "database",
    "security"
  ],
  "$id": "https://recordari.github.io/postgres-mcp/config.schema.json",
  "title": "postgres-mcp configuration",
  "description": "YAML configuration for the postgres-mcp server. Only ${DATABASE_URL} and ${MCP_TOKEN} may appear as env placeholders in YAML files.",
  "x-postgres-mcp-version": "0.2.0"
}
