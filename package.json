{
  "name": "postgres-mcp",
  "version": "0.2.0",
  "description": "A secure, self-hosted PostgreSQL MCP server. One Docker container. One YAML file. Read-only by default.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:check": "node scripts/print-release-version.mjs",
    "config:validate": "tsx scripts/validate-config.ts",
    "config:schema": "tsx scripts/generate-config-schema.ts",
    "config:schema:check": "npm run config:schema && git diff --exit-code -- docs/config.schema.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/mcp": "^0.0.4",
    "@nestjs/platform-express": "^12.5.1",
    "js-yaml": "^5.5.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pgsql-parser": "^18.3.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
